<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon for Android 7.0 and 7.1, which do not know adaptive icons.
    The same mark, already sitting on its indigo tile.
    Android 8.0 and later pick mipmap-anydpi-v26 instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M28,4 H80 A24,24 0 0 1 104,28 V80 A24,24 0 0 1 80,104 H28 A24,24 0 0 1 4,80 V28 A24,24 0 0 1 28,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="4"
                android:endX="104"
                android:endY="104">
                <item
                    android:color="#4A3AD0"
                    android:offset="0" />
                <item
                    android:color="#26109C"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.25"
        android:scaleY="1.25">
        <path
            android:pathData="M26,40 L26,26 L40,26"
