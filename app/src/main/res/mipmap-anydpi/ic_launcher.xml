            android:pathData="M82,40 L82,26 L68,26"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M82,68 L82,82 L68,82"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M26,68 L26,82 L40,82"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M30,54 L78,54"
            android:strokeColor="#FFB877"
            android:strokeWidth="8"
            android:strokeLineCap="round" />
