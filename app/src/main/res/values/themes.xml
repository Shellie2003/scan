<?xml version="1.0" encoding="utf-8"?>
<!--
    Window themes. The interface itself is drawn by Compose (ui/theme/Theme.kt);
    what is declared here is only what exists before the first frame: the colour
    of the window and the launch screen.
-->
<resources>

    <style name="Theme.Scan" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Only the launcher activity: the mark on indigo while the app starts. -->
    <style name="Theme.Scan.Launch" parent="Theme.Scan">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        The call screen opens over the lock screen, and the colour its window
        starts on matters: it is what fills the screen before the first frame.

        Nothing is declared here on purpose. Theme.Scan is light in this file
        and dark in values-night, so inheriting already gives a call at night a
        dark window and a call by day a light one. An earlier version of this
        style forced the dark surface for everyone, which only moved the flash
        from the users of one theme to the users of the other.
    -->
    <style name="Theme.Scan.Call" parent="Theme.Scan" />

</resources>
